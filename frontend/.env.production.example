# ============================================================
# Vercel Dashboard — Environment Variables Template
# Forecast Earthings Frontend (Public Website)
# ============================================================
# Set these in: Vercel Dashboard → Your Frontend Project
#               → Settings → Environment Variables
# Select: Production + Preview + Development checkboxes
# ============================================================

# URL of the deployed backend on Render
# Example: https://forecast-earthings-backend.onrender.com/api/v1
NEXT_PUBLIC_API_URL=https://your-render-backend.onrender.com/api/v1

# Your frontend's own Vercel URL (used for canonical links / OG tags)
NEXT_PUBLIC_SITE_URL=https://your-frontend.vercel.app

# Cloudinary cloud name (safe to expose — public read-only)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=bctl2gxd

# ISR Revalidation secret — must match backend REVALIDATION_SECRET
# This is a SERVER-SIDE secret, do NOT prefix with NEXT_PUBLIC_
REVALIDATION_SECRET=<same-random-secret-as-backend>
