# ============================================================
# Render Dashboard — Environment Variables Template
# Forecast Earthings Backend
# ============================================================
# Copy each variable below into the Render Dashboard under
# your service → Environment → Add Environment Variable.
# NEVER commit actual secret values to Git.
# ============================================================

# ── MongoDB Atlas ───────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGODB_DATABASE=forecast_earthings

# ── JWT Authentication ──────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=<generate-a-strong-random-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=600

# ── CORS Allowed Origins ────────────────────────────────────
# Replace with your actual Vercel deployment URLs
# Both frontend and admin URLs must be included
CORS_ORIGINS=["https://your-frontend.vercel.app","https://your-admin.vercel.app"]

# ── Cloudinary CDN ──────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=bctl2gxd
CLOUDINARY_API_KEY=<your-cloudinary-api-key>
CLOUDINARY_API_SECRET=<your-cloudinary-api-secret>
CLOUDINARY_URL=cloudinary://<api-key>:<api-secret>@bctl2gxd
CLOUDINARY_FOLDER=forecast_earthings

# ── Media Storage (use cloudinary in production) ────────────
MEDIA_STORAGE_TYPE=cloudinary
MEDIA_UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ── Admin Seed Credentials ──────────────────────────────────
ADMIN_EMAIL=admin@forecastearthings.com
ADMIN_PASSWORD=<strong-admin-password>

# ── Next.js ISR Revalidation Webhook ────────────────────────
# Set NEXT_PUBLIC_REVALIDATION_URL after deploying the frontend
NEXT_PUBLIC_REVALIDATION_URL=https://your-frontend.vercel.app/api/revalidate
REVALIDATION_SECRET=<random-secret-string>

# ── Runtime Config ──────────────────────────────────────────
APP_ENV=production
