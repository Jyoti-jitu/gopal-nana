# ============================================================
# Vercel Dashboard — Environment Variables Template
# Forecast Earthings Admin Panel
# ============================================================
# Set these in: Vercel Dashboard → Your Admin Project
#               → Settings → Environment Variables
# Select: Production + Preview + Development checkboxes
# ============================================================

# URL of the deployed backend on Render (with /api/v1 suffix)
# Example: https://forecast-earthings-backend.onrender.com/api/v1
NEXT_PUBLIC_API_URL=https://your-render-backend.onrender.com/api/v1

# Public frontend site URL (used for "View Site" links inside admin)
NEXT_PUBLIC_PUBLIC_SITE_URL=https://your-frontend.vercel.app

# Cloudinary cloud name (safe to expose — public read-only)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=bctl2gxd
